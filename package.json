{
  "name": "cypress-typescript-framework",
  "version": "1.0.0",
  "description": "Cypress + TypeScript E2E testing framework",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "cy:run": "cypress run --browser edge",
    "cy:run:api": "cypress run --browser edge --spec \"cypress/e2e/api/**/*.cy.ts\"",
    "report": "node scripts/report.js",
    "allure:generate": "allure generate allure-results",
    "allure:open": "allure open allure-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cesarbeassuarez/cypress-typescript-framework.git"
  },
