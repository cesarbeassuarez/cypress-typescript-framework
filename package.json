  },
  "homepage": "https://github.com/cesarbeassuarez/cypress-typescript-framework#readme",
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "allure": "^3.18.0",
    "allure-cypress": "^3.12.2",
    "cypress": "^15.17.0",
    "cypress-mochawesome-reporter": "^5.0.0",
    "cypress-on-fix": "^1.1.0",
    "cypress-real-events": "^1.15.0",
